{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "isBanned": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "role": {
          ".validate": "auth.uid !== $uid || newData.val() === 'cafe_owner' || newData.val() === 'shop_owner' || newData.val() === 'accessory_owner' || !newData.exists()"
        }
      }
    },

    "gameReviews": {
      ".read": "auth != null",
      "$gameId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['review', 'userId', 'gameId']) && root.child('users').child(auth.uid).child('isBanned').val() !== true",
          "review": {
            ".validate": "newData.isString() && (newData.val() === 'skip' || newData.val() === 'timepass' || newData.val() === 'go-for-it' || newData.val() === 'perfection')"
          },
          "userId": {
            ".validate": "newData.val() === auth.uid"
          },
          "gameId": { ".validate": "newData.isString()" },
          "gameName": { ".validate": "newData.isString()" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "userName": { ".validate": "newData.isString()" },
          "initials": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": true },
          "updatedAt": { ".validate": true },

          "likes": {
            "$likerUid": {
              ".write": "auth != null && auth.uid === $likerUid",
              ".validate": "newData.isBoolean()"
            }
          },

          "comments": {
            "$commentId": {
              ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('userId').val() === auth.uid) || auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.hasChildren(['userId', 'text', 'createdAt'])",
              "userId": { ".validate": "newData.val() === auth.uid" },
              "userName": { ".validate": "newData.isString()" },
              "initials": { ".validate": "newData.isString()" },
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
              },
              "createdAt": { ".validate": true },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    },

    "cart": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "wishlists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "products": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && (data.child('sellerId').val() === auth.uid || newData.child('sellerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' || root.child('users').child(auth.uid).child('role').val() === 'shop_owner' || root.child('users').child(auth.uid).child('role').val() === 'accessory_owner' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "orders": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' || root.child('users').child(auth.uid).child('role').val() === 'shop_owner' || root.child('users').child(auth.uid).child('role').val() === 'accessory_owner' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$orderId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid)",
        ".write": "auth != null && (data.child('sellerId').val() === auth.uid || data.child('buyerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' || root.child('users').child(auth.uid).child('role').val() === 'shop_owner' || root.child('users').child(auth.uid).child('role').val() === 'accessory_owner')"
      }
    },

    "cafes": {
      ".read": true,
      "$cafeId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('ownedCafeIds').child($cafeId).val() === true)",
        "status": {
          ".validate": "newData.val() === 'pending' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'"
        }
      }
    },

    "cafeBookings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$customerId": {
        ".read": "auth != null && auth.uid === $customerId",
        ".write": "auth != null && ((auth.uid === $customerId && root.child('users').child(auth.uid).child('isBanned').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "cafeSlots": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "clubs": {
      ".read": true,
      "$clubId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('ownerUid').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "memberCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === (data.exists() ? data.val() : 0) + 1 || newData.val() === (data.exists() ? data.val() : 0) - 1)"
        }
      }
    },

    "userClubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "clubDiscussions": {
      "$clubId": {
        ".read": "auth != null",
        "$discussionId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['title', 'authorUid', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 200"
        }
      }
    },

    "communityTalks": {
      ".read": "auth != null",
      "$talkId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['title', 'authorUid', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 200"
      }
    },

    "adminGames": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "hiddenGames": {
      ".read": true,
      "$gameKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
