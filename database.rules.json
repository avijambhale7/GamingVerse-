{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["role"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && data.child('isBanned').val() !== true",
        ".validate": "newData.child('isBanned').val() === data.child('isBanned').val() || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "isBanned": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isBoolean()"
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.parent().exists() && auth.uid === $uid && (newData.val() === 'cafe_owner' || newData.val() === 'shop_owner' || newData.val() === 'accessory_owner'))"
        },
        "ownedCafeIds": {
          "$cafeId": {
            ".validate": "newData.val() !== true || root.child('cafes').child($cafeId).child('ownerUid').val() === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[6-9][0-9]{9}$/)"
        }
      }
    },

    "gameReviews": {
      ".read": "auth != null",
      "$gameId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['review', 'userId', 'gameId']) && root.child('users').child(auth.uid).child('isBanned').val() !== true",
          "review": {
            ".validate": "newData.isString() && (newData.val() === 'skip' || newData.val() === 'timepass' || newData.val() === 'go-for-it' || newData.val() === 'perfection')"
          },
          "userId": {
            ".validate": "newData.val() === auth.uid"
          },
          "gameId": { ".validate": "newData.isString()" },
          "gameName": { ".validate": "newData.isString()" },
          "gameImage": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 2048" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "userName": { ".validate": "newData.isString()" },
          "initials": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": true },
          "updatedAt": { ".validate": true },

          "likes": {
            "$likerUid": {
              ".write": "auth != null && auth.uid === $likerUid",
              ".validate": "newData.isBoolean()"
            }
          },

          "comments": {
            "$commentId": {
              ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('userId').val() === auth.uid) || auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".validate": "newData.hasChildren(['userId', 'text', 'createdAt'])",
              "userId": { ".validate": "newData.val() === auth.uid" },
              "userName": { ".validate": "newData.isString()" },
              "initials": { ".validate": "newData.isString()" },
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
              },
              "createdAt": { ".validate": true },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    },

    "usernames": {
      "$handle": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
        ".validate": "newData.isString() && $handle.matches(/^[a-z0-9_.]{3,20}$/)"
      }
    },

    "posts": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "uid"],
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
        ".validate": "newData.hasChildren(['uid', 'createdAt']) && (newData.hasChild('imageData') || newData.hasChild('imageURL'))",
        "uid": { ".validate": "newData.val() === auth.uid" },
        "imageURL": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 2048" },
        "imageData": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 600000" },
        "caption": { ".validate": "newData.isString() && newData.val().length <= 2200" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "authorHandle": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "authorPhoto": { ".validate": "newData.isString() && newData.val().length <= 2048" },
        "game": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "postLikes": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && !newData.exists() && (root.child('posts').child($postId).child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$likerUid": {
          ".write": "auth != null && auth.uid === $likerUid && (!newData.exists() || root.child('posts').child($postId).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },

    "postComments": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && !newData.exists() && (root.child('posts').child($postId).child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true && root.child('posts').child($postId).exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('posts').child($postId).child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
          ".validate": "newData.hasChildren(['uid', 'text', 'createdAt'])",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "authorName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "authorHandle": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "postReports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$postId": {
        ".write": "auth != null && !newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$reporterUid": {
          ".write": "auth != null && auth.uid === $reporterUid && !data.exists() && root.child('posts').child($postId).exists()",
          ".validate": "newData.hasChildren(['reason', 'createdAt'])",
          "reason": { ".validate": "newData.isString() && newData.val().matches(/^(spam|offensive|inappropriate|other)$/)" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "follows": {
      "$uid": {
        ".read": "auth != null",
        "$targetUid": {
          ".write": "auth != null && auth.uid === $uid && $targetUid !== $uid && (!newData.exists() || root.child('users').child(auth.uid).child('isBanned').val() !== true)",
          ".validate": "newData.hasChildren(['createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "handle": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "followers": {
      "$targetUid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $targetUid !== $uid && (!newData.exists() || root.child('users').child(auth.uid).child('isBanned').val() !== true)",
          ".validate": "newData.hasChildren(['createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "handle": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "gameAlerts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$alertKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'releaseDate'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "releaseDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "reminded": { ".validate": "newData.isBoolean()" },
          "released": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },

    "cafeReviews": {
      ".read": "auth != null",
      "$cafeId": {
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (root.child('users').child(auth.uid).child('isBanned').val() !== true && root.child('cafeBookings').child(auth.uid).child(newData.child('bookingId').val()).child('status').val() === 'Completed' && root.child('cafeBookings').child(auth.uid).child(newData.child('bookingId').val()).child('cafeId').val() === $cafeId))) || (!newData.exists() && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
          ".validate": "newData.hasChildren(['rating', 'bookingId', 'createdAt'])",
          "rating": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "bookingId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "createdAt": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "userReviews": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$gameId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },

    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$tokenKey": {
          ".validate": "newData.hasChildren(['token', 'createdAt']) && newData.child('token').isString() && newData.child('token').val().length < 1024"
        }
      }
    },

    "savedCafes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$cafeId": { ".validate": "newData.isBoolean()" }
      }
    },

    "wishlists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "products": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && ((!data.exists() && newData.child('sellerId').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('sellerId').val() === auth.uid && (!newData.exists() || newData.child('sellerId').val() === auth.uid)) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['name', 'price', 'stock', 'sellerId'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "price": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000" },
        "stock": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "sellerId": { ".validate": "newData.isString()" },
        "sellerName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "image": { ".validate": "newData.isString() && newData.val().length <= 450000" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(active|blocked|sold)$/)" },
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" }
      }
    },

    "purchaseRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || ((query.orderByChild === 'buyerId' || query.orderByChild === 'sellerId') && query.equalTo === auth.uid))",
      ".indexOn": ["buyerId", "sellerId"],
      "$requestId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.child('buyerId').val() === auth.uid && newData.child('status').val() === 'pending_admin' && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.child('buyerId').val() === auth.uid && (data.child('status').val() === 'pending_admin' || data.child('status').val() === 'pending_seller') && newData.child('status').val() === 'cancelled') || (data.child('sellerId').val() === auth.uid && data.child('status').val() === 'pending_seller' && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'seller_rejected')) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!newData.exists() || (data.child('status').val() === 'pending_admin' && (newData.child('status').val() === 'pending_seller' || newData.child('status').val() === 'admin_rejected')))))",
        ".validate": "newData.hasChildren(['productId', 'buyerId', 'sellerId', 'status', 'quantity', 'createdAt']) && (data.exists() ? (newData.child('buyerId').val() === data.child('buyerId').val() && newData.child('sellerId').val() === data.child('sellerId').val() && newData.child('productId').val() === data.child('productId').val() && newData.child('quantity').val() === data.child('quantity').val()) : (newData.child('sellerId').val() !== auth.uid && root.child('products').child(newData.child('productId').val()).child('sellerId').val() === newData.child('sellerId').val()))",
        "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pending_admin|admin_rejected|pending_seller|seller_rejected|accepted|cancelled)$/)"
        }
      }
    },

    "purchaseRequestContacts": {
      "$requestId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('purchaseRequests').child($requestId).child('status').val() === 'accepted' && (root.child('purchaseRequests').child($requestId).child('buyerId').val() === auth.uid || root.child('purchaseRequests').child($requestId).child('sellerId').val() === auth.uid)))",
        "buyerPhone": {
          ".write": "auth != null && !data.exists() && root.child('purchaseRequests').child($requestId).child('buyerId').val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === root.child('users').child(auth.uid).child('phone').val()"
        },
        "sellerPhone": {
          ".write": "auth != null && root.child('purchaseRequests').child($requestId).child('sellerId').val() === auth.uid && root.child('purchaseRequests').child($requestId).child('status').val() === 'pending_seller'",
          ".validate": "newData.isString() && newData.val() === root.child('users').child(auth.uid).child('phone').val()"
        }
      }
    },

    "cafes": {
      ".read": "(query.orderByChild === 'status' && query.equalTo === 'approved') || (auth != null && ((query.orderByChild === 'ownerUid' && query.equalTo === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')))",
      ".indexOn": ["status", "ownerUid"],
      "$cafeId": {
        ".read": "data.child('status').val() === 'approved' || (auth != null && (data.child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')))",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('users').child(auth.uid).child('role').val() === 'cafe_owner' && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)) || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === data.val() || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')"
        }
      }
    },

    "cafeBookings": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$customerId": {
        ".read": "auth != null && auth.uid === $customerId",
        "$bookingId": {
          ".read": "auth != null && root.child('cafes').child(data.child('cafeId').val()).child('ownerUid').val() === auth.uid",
          ".write": "auth != null && ((auth.uid === $customerId && root.child('users').child(auth.uid).child('isBanned').val() !== true && (!newData.exists() || (!data.exists() && (newData.child('walkIn').val() === true ? root.child('cafes').child(newData.child('cafeId').val()).child('ownerUid').val() === auth.uid : newData.child('status').val() === 'Pending')))) || (data.exists() && root.child('cafes').child(data.child('cafeId').val()).child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('cafeId').val() === data.child('cafeId').val())) || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
          ".validate": "newData.hasChildren(['cafeId', 'date', 'time', 'status']) && (data.exists() || newData.hasChild('seats')) && root.child('cafes').child(newData.child('cafeId').val()).exists()",
          "cafeId": { ".validate": "newData.isString()" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "time": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "seats": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(Pending|Confirmed|Rejected|Completed|Cancelled)$/)" },
          "pricePerHour": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "totalPrice": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!newData.parent().child('pricePerHour').exists() || !newData.parent().child('seats').exists() || newData.val() === newData.parent().child('pricePerHour').val() * newData.parent().child('seats').val())" },
          "customerName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "customerEmail": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "customerPhone": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "walkIn": { ".validate": "newData.isBoolean()" }
        }
      }
    },

    "cafeBookingIndex": {
      "$cafeId": {
        ".read": "auth != null && (root.child('cafes').child($cafeId).child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
        "$bookingId": {
          ".write": "auth != null && ((newData.exists() && newData.child('customerId').val() === auth.uid && newData.parent().parent().parent().child('cafeBookings').child(auth.uid).child($bookingId).child('cafeId').val() === $cafeId) || (!newData.exists() && (data.child('customerId').val() === auth.uid || root.child('cafes').child($cafeId).child('ownerUid').val() === auth.uid)) || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner'))",
          ".validate": "newData.hasChildren(['customerId'])",
          "customerId": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },

    "cafeSlots": {
      ".read": "auth != null",
      "$cafeId": {
        "$date": {
          "$slot": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('isBanned').val() !== true && (newData.exists() || data.child('booked').val() <= 4 || (root.child('cafes').child($cafeId).child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')))",
            ".validate": "newData.hasChildren(['booked']) && newData.child('booked').isNumber() && newData.child('booked').val() >= 1 && newData.child('booked').val() - (data.exists() ? data.child('booked').val() : 0) <= 4 && (data.exists() ? data.child('booked').val() : 0) - newData.child('booked').val() <= 4 && (newData.child('booked').val() <= (root.child('cafes').child($cafeId).child('totalSeats').isNumber() && root.child('cafes').child($cafeId).child('totalSeats').val() > 0 ? root.child('cafes').child($cafeId).child('totalSeats').val() : 6) || newData.child('booked').val() <= (data.exists() ? data.child('booked').val() : 0) || (root.child('cafes').child($cafeId).child('ownerUid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'owner')))",
            "booked": { ".validate": true },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "clubs": {
      ".read": true,
      "$clubId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || (data.exists() && data.child('ownerUid').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "memberCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1 && newData.parent().child('ownerUid').val() === auth.uid) || (newData.val() === data.val() + 1 && !root.child('userClubs').child(auth.uid).child($clubId).exists() && newData.parent().parent().parent().child('userClubs').child(auth.uid).child($clubId).val() === true) || (newData.val() === data.val() - 1 && root.child('userClubs').child(auth.uid).child($clubId).exists() && !newData.parent().parent().parent().child('userClubs').child(auth.uid).child($clubId).exists()))"
        }
      }
    },

    "userClubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "clubDiscussions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$clubId": {
        ".read": "auth != null",
        "$discussionId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['title', 'authorUid', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 200"
        }
      }
    },

    "communityTalks": {
      ".read": "auth != null",
      "$talkId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['title', 'authorUid', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 200"
      }
    },

    "adminGames": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "hiddenGames": {
      ".read": "auth != null",
      "$gameKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true",
          ".validate": "newData.child('message').isString() && newData.child('message').val().length <= 500"
        }
      }
    },

    "adminNotifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$notificationId": {
        ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid && root.child('users').child(auth.uid).child('isBanned').val() !== true",
        ".validate": "newData.child('message').isString() && newData.child('message').val().length <= 500"
      }
    }
  }
}
